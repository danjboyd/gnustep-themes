/* Gumdrop (fun-themes) - DRAFT for the fun-themes owner's review.
   Semantics from owner msgs #20599/#20861 at b3a960d, Source/GumdropMenus.m:65-76,
   GumdropWindow.m:201,522-576. An Info.plist value other than "menubar" ends as
   primary, so only "menubar" is listed as winning from Info.plist. */
{
  SchemaVersion = 1;
  Theme = Gumdrop;
  ThemeIdentifier = "org.gnustep.themes.gumdrop";
  Groups = ( { Identifier = menus; Title = "Menus"; } );
  Settings = (
    {
      Identifier = "gumdrop.menu-style";
      Key = GumdropMenuStyle;
      Type = enum;
      CaseInsensitive = YES;
      Values = (
        { Value = primary; Title = "In window (primary)"; },
        { Value = menubar; Title = "Menu bar"; }
      );
      Scopes = ( global, application );
      Group = menus;
      Title = "Menu style";
      /* Unset: falls back to the main app's Info.plist, then primary.
         Removing an override is NOT the same as storing primary. */
      Unset = { Behavior = static; Value = primary; };
      Precedence = ( argument, application, global, { Source = applicationInfo; Values = ( menubar ); } );
      Apply = restart;
    }
  );
}
