/* Core font and window settings use Gumdrop's GSThemeDomain fallbacks.
   GNUstep ranks application and global defaults above that domain. */
{
  SchemaVersion = 1;
  Theme = Gumdrop;
  ThemeIdentifier = "org.gnustep.themes.gumdrop";
  Groups = (
    { Identifier = layout; Title = "Layout"; },
    { Identifier = menus; Title = "Menus"; },
    { Identifier = text; Title = "Text"; },
    { Identifier = windows; Title = "Windows"; }
  );
  Settings = (
    {
      Identifier = "gumdrop.size"; Key = GumdropSize; Type = enum; CaseInsensitive = YES;
      Values = ( { Value = Regular; Title = "Regular"; }, { Value = Compact; Title = "Compact"; } );
      Scopes = ( global, application ); Group = layout; Title = "Control size";
      Help = "Compact uses 87.5% control sizes and default font sizes. An explicit Default system font size wins. Apps with fixed layouts may keep their existing spacing.";
      Overlaps = ( "gumdrop.font-size" );
      Unset = { Behavior = dynamic; Help = "the app's own preference, else Regular on Linux and Compact on Windows"; };
      Precedence = ( argument, application, global, { Source = applicationInfo; Values = ( Regular, Compact ); } );
      Apply = restart;
    },
    {
      Identifier = "gumdrop.menu-style"; Key = GumdropMenuStyle; Type = enum; CaseInsensitive = YES;
      Values = ( { Value = primary; Title = "Title-bar menu button"; }, { Value = menubar; Title = "In-window menu bar"; } );
      Scopes = ( global, application ); Group = menus; Title = "Menu style";
      Unset = { Behavior = static; Value = primary; };
      Precedence = ( argument, application, global, { Source = applicationInfo; Values = ( menubar ); } );
      Apply = restart;
    },
    {
      Identifier = "gumdrop.font"; Key = NSFont; Type = string;
      Scopes = ( global, application ); Group = text; Title = "Default system font";
      Help = "Font name as GNUstep knows it (for example DejaVuSans). Most standard controls use this base font. Menus, text views, bold text and some labels use separate role fonts.";
      Unset = { Behavior = static; Value = DejaVuSans; };
      Apply = restart;
    },
    {
      Identifier = "gumdrop.font-size"; Key = NSFontSize; Type = number; Minimum = 0;
      Overlaps = ( "gumdrop.size" );
      Scopes = ( global, application ); Group = text; Title = "Default system font size";
      Help = "Default system font size in points. 0 uses GNUstep's built-in default size. Explicit role font sizes remain independent of this setting.";
      Unset = { Behavior = dynamic; Help = "14.6667 points in Regular, 12.8334 points in Compact"; };
      Apply = restart;
    },
    {
      Identifier = "gumdrop.window-corner-radius"; Key = GSBackWindowCornerRadius; Type = number; Minimum = 0;
      Scopes = ( global, application ); Group = windows; Title = "Window corner radius";
      Help = "Rounding of window corners, in points. Only where the display backend draws the window frame; larger values are limited to half the window size.";
      Unset = { Behavior = static; Value = 8; };
      Apply = newWindows;
    },
    {
      Identifier = "gumdrop.window-shadows"; Key = GSBackWindowShadows; Type = bool;
      Scopes = ( global, application ); Group = windows; Title = "Window shadows";
      Help = "Shadows around windows. Only where the display backend supports them.";
      Unset = { Behavior = static; Value = YES; };
      Apply = newWindows;
    }
  );
}
