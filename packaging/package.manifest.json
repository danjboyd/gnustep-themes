{
  "$schema": "https://raw.githubusercontent.com/danjboyd/gnustep-packager/9a8c784/schemas/gnustep-packager.schema.json",
  "schemaVersion": 1,
  "profiles": [
    "gnustep-gui"
  ],
  "package": {
    "id": "io.github.danjboyd.ThemeSettings",
    "name": "ThemeSettings",
    "displayName": "Theme Settings",
    "version": "0.1.0",
    "manufacturer": "Daniel Boyd",
    "summary": "Choose a GNUstep theme and change its settings for all applications or one.",
    "license": "LGPL-2.1-or-later",
    "homepage": "https://github.com/danjboyd/gnustep-themes"
  },
  "pipeline": {
    "workingDirectory": "..",
    "shell": {
      "kind": "bash",
      "bootstrapCommands": [
        ". \"${GP_GNUSTEP_CLI_ROOT:-/usr/GNUstep}/System/Library/Makefiles/GNUstep.sh\""
      ],
      "environment": {}
    },
    "build": {
      "command": "./packaging/build.sh"
    },
    "stage": {
      "command": "./packaging/stage.sh dist/stage",
      "outputRoot": "../dist/stage"
    }
  },
  "payload": {
    "layoutVersion": 1,
    "stageRoot": "../dist/stage",
    "appRoot": "app",
    "runtimeRoot": "runtime",
    "metadataRoot": "metadata"
  },
  "launch": {
    "entryRelativePath": "app/ThemeSettings.app/ThemeSettings",
    "workingDirectory": "app/ThemeSettings.app",
    "arguments": [
      "-GSTheme",
      "GNUstep"
    ],
    "pathPrepend": [
      "runtime/bin",
      "runtime/System/Tools"
    ],
    "env": {
      "LD_LIBRARY_PATH": {
        "value": "{@runtimeRoot}/lib:{@runtimeRoot}/System/Library/Libraries",
        "policy": "prepend"
      },
      "GTS_HOST_THEME_ROOTS": {
        "value": "~/GNUstep/Library/Themes:/usr/local/lib/GNUstep/Themes:/usr/lib/GNUstep/Themes:/usr/GNUstep/Local/Library/Themes:/usr/GNUstep/System/Library/Themes",
        "policy": "ifUnset"
      }
    }
  },
  "outputs": {
    "root": "../dist",
    "packageRoot": "../dist/packages",
    "logRoot": "../dist/logs",
    "tempRoot": "../dist/tmp",
    "validationRoot": "../dist/validation"
  },
  "validation": {
    "smoke": {
      "enabled": true,
      "kind": "staged-layout",
      "requiredPaths": [
        "metadata/icons/ThemeSettings.png"
      ],
      "timeoutSeconds": 30
    },
    "logs": {
      "retainOnSuccess": true
    }
  },
  "integrations": {
    "shortcutName": "Theme Settings",
    "fileAssociations": []
  },
  "updates": {
    "enabled": false
  },
  "compliance": {
    "runtimeNotices": [
      {
        "name": "GNUstep Runtime",
        "license": "LGPL-2.1-or-later",
        "stageRelativePath": "metadata/licenses/gnustep-runtime.txt"
      }
    ]
  },
  "hostDependencies": {
    "linux": {
      "aptPackages": [
        "imagemagick",
        "libgnutls28-dev",
        "pkg-config",
        "fonts-dejavu-core"
      ]
    }
  },
  "backends": {
    "msi": {
      "enabled": false
    },
    "appimage": {
      "enabled": true,
      "desktopEntryName": "io.github.danjboyd.ThemeSettings.desktop",
      "iconRelativePath": "metadata/icons/ThemeSettings.png",
      "gnustepConfig": {
        "systemRoot": "runtime/System",
        "userLibrary": "app"
      },
      "smoke": {
        "mode": "launch-only"
      },
      "fonts": {
        "bundle": [
          {
            "name": "DejaVu",
            "files": [
              "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
              "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
              "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
              "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"
            ],
            "licenseFile": "/usr/share/doc/fonts-dejavu-core/copyright",
            "license": "Bitstream-Vera AND LicenseRef-DejaVu-public-domain",
            "homepage": "https://dejavu-fonts.github.io/"
          }
        ]
      }
    }
  }
}
